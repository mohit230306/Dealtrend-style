# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Set a strong admin password in environment secrets for production.
# If unset, initial setup uses the default passcode documented in the admin login helper.
ADMIN_PASSWORD=""

# SESSION_SECRET: Secret key used to sign HTTP-only admin session cookies.
SESSION_SECRET=""
