{
  "entities": {
    "PublicStoreConfig": {
      "title": "PublicStoreConfig",
      "description": "Public customer-facing store branding, shipping rules, and payment display configuration without any reseller or webhook secrets.",
      "type": "object",
      "properties": {
        "storeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Storefront display name"
        },
        "storeDescription": {
          "type": "string",
          "maxLength": 600,
          "description": "Customer-facing store description shown on the Home page hero section"
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 500000,
          "description": "Store logo image URL or data URI"
        },
        "heroImageUrl": {
          "type": "string",
          "maxLength": 500000,
          "description": "Optional storefront hero image URL or data URI"
        },
        "currencySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "description": "Currency symbol"
        },
        "announcementText": {
          "type": "string",
          "maxLength": 300,
          "description": "Top announcement bar text"
        },
        "codEnabled": {
          "type": "boolean",
          "description": "Whether Cash on Delivery is enabled"
        },
        "onlinePaymentEnabled": {
          "type": "boolean",
          "description": "Whether Online Payment is enabled"
        },
        "upiId": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional merchant UPI ID"
        },
        "paymentGatewayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display label for online payment"
        },
        "paymentGatewayNote": {
          "type": "string",
          "maxLength": 500,
          "description": "Verification note for online payment"
        },
        "freeShippingThreshold": {
          "type": "number",
          "description": "Minimum subtotal for free shipping"
        },
        "shippingFee": {
          "type": "number",
          "description": "Standard shipping fee"
        },
        "supportPhone": {
          "type": "string",
          "maxLength": 40,
          "description": "Customer support phone number"
        },
        "supportEmail": {
          "type": "string",
          "maxLength": 120,
          "description": "Customer support email"
        },
        "supportAddress": {
          "type": "string",
          "maxLength": 300,
          "description": "Dispatch/support address"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": [
        "storeName",
        "storeDescription",
        "logoUrl",
        "heroImageUrl",
        "currencySymbol",
        "announcementText",
        "codEnabled",
        "onlinePaymentEnabled",
        "upiId",
        "paymentGatewayName",
        "paymentGatewayNote",
        "freeShippingThreshold",
        "shippingFee",
        "supportPhone",
        "supportEmail",
        "supportAddress",
        "updatedAt"
      ]
    },
    "AdminSettingsConfig": {
      "title": "AdminSettingsConfig",
      "description": "Private admin-only settings including Google Apps Script Web App URL and Google Drive folder link.",
      "type": "object",
      "properties": {
        "appsScriptUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Private Google Apps Script Web App URL"
        },
        "googleDriveFolderUrl": {
          "type": "string",
          "maxLength": 1000,
          "description": "Private Google Drive folder reference"
        },
        "lastConnectionTestAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of last Apps Script connection test"
        },
        "lastConnectionStatus": {
          "type": "string",
          "enum": ["Connected", "Failed", "Not Configured"],
          "description": "Status of last Apps Script test"
        },
        "lastConnectionMessage": {
          "type": "string",
          "maxLength": 500,
          "description": "Message from last Apps Script test"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update"
        }
      },
      "required": [
        "appsScriptUrl",
        "googleDriveFolderUrl",
        "lastConnectionStatus",
        "lastConnectionMessage",
        "updatedAt"
      ]
    },
    "PublicProduct": {
      "title": "PublicProduct",
      "description": "Customer-facing product catalog entry with selling price and internal product code only. Never contains Hidden products, source price, profit, or source URL.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Product ID"
        },
        "productCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Internal Product Code"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Product title"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Product category"
        },
        "images": {
          "type": "array",
          "description": "Up to 12 product image URLs"
        },
        "originalPrice": {
          "type": "number",
          "description": "Compare-at MRP"
        },
        "sellingPrice": {
          "type": "number",
          "description": "Customer selling price"
        },
        "onlinePrice": {
          "type": "number",
          "description": "Optional separate customer price when paying via Online / UPI"
        },
        "discountPercent": {
          "type": "number",
          "description": "Discount percentage"
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "description": "Customer-facing product description"
        },
        "availableStock": {
          "type": "number",
          "description": "Order quantity cap"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Out of Stock"],
          "description": "Public visibility status"
        },
        "reviews": {
          "type": "array",
          "description": "Up to 20 admin-curated customer reviews (each with optional up to 4 photos)"
        },
        "colorOptions": {
          "type": "array",
          "description": "Up to 20 Color or Design variant options, optionally linked via imageIndex to product images"
        },
        "sizeOptions": {
          "type": "array",
          "description": "Up to 20 Size variant labels (e.g. S, M, L, XL, Free Size)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "productCode",
        "name",
        "category",
        "images",
        "originalPrice",
        "sellingPrice",
        "discountPercent",
        "description",
        "availableStock",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminProduct": {
      "title": "AdminProduct",
      "description": "Full reseller product catalog including Hidden products, supplier source price, expected profit, and internal supplier reference link.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Product ID"
        },
        "productCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Internal Product Code"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Product name"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Product category"
        },
        "images": {
          "type": "array",
          "description": "Up to 12 product image URLs"
        },
        "originalPrice": {
          "type": "number",
          "description": "Compare-at MRP"
        },
        "sellingPrice": {
          "type": "number",
          "description": "Customer selling price"
        },
        "onlinePrice": {
          "type": "number",
          "description": "Optional separate customer price when paying via Online / UPI"
        },
        "discountPercent": {
          "type": "number",
          "description": "Discount percentage"
        },
        "sourcePrice": {
          "type": "number",
          "description": "Admin-only supplier source price"
        },
        "expectedProfit": {
          "type": "number",
          "description": "Admin-only expected profit per unit"
        },
        "sourceProductUrl": {
          "type": "string",
          "maxLength": 2000,
          "description": "Admin-only supplier/Meesho product reference link"
        },
        "description": {
          "type": "string",
          "maxLength": 4000,
          "description": "Product description"
        },
        "availableStock": {
          "type": "number",
          "description": "Order quantity cap"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Out of Stock", "Hidden"],
          "description": "Product visibility status"
        },
        "reviews": {
          "type": "array",
          "description": "Up to 20 admin-curated customer reviews (each with optional up to 4 photos)"
        },
        "colorOptions": {
          "type": "array",
          "description": "Up to 20 Color or Design variant options, optionally linked via imageIndex to product images"
        },
        "sizeOptions": {
          "type": "array",
          "description": "Up to 20 Size variant labels (e.g. S, M, L, XL, Free Size)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "productCode",
        "name",
        "category",
        "images",
        "originalPrice",
        "sellingPrice",
        "discountPercent",
        "sourcePrice",
        "expectedProfit",
        "sourceProductUrl",
        "description",
        "availableStock",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order record with delivery details, COD/Online payment state, and reseller fulfillment/profit metrics.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Order ID"
        },
        "timestamp": {
          "type": "string",
          "maxLength": 64,
          "description": "Order ISO timestamp"
        },
        "customerName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Customer full name"
        },
        "mobileNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "description": "Customer 10-digit mobile number"
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional customer email"
        },
        "fullAddress": {
          "type": "string",
          "minLength": 6,
          "maxLength": 500,
          "description": "Delivery street address"
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Delivery city"
        },
        "state": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Delivery state"
        },
        "pincode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[0-9]{6}$",
          "description": "6-digit delivery pincode"
        },
        "landmark": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional delivery landmark"
        },
        "items": {
          "type": "array",
          "description": "Ordered line items (1 to 50)"
        },
        "productNames": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Formatted summary of product names"
        },
        "productCodes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Comma-separated internal product codes"
        },
        "quantity": {
          "type": "number",
          "description": "Total item quantity"
        },
        "subtotal": {
          "type": "number",
          "description": "Items subtotal"
        },
        "shippingFee": {
          "type": "number",
          "description": "Applied shipping fee"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total customer order amount"
        },
        "sourceOrderAmount": {
          "type": "number",
          "description": "Admin-only total supplier cost"
        },
        "expectedProfit": {
          "type": "number",
          "description": "Admin-only expected profit"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["COD", "Online"],
          "description": "Selected payment method"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["Unpaid", "Pending", "Pending Verification", "Paid", "Refunded"],
          "description": "Payment verification status"
        },
        "codAmount": {
          "type": "number",
          "description": "COD amount payable on delivery"
        },
        "orderStatus": {
          "type": "string",
          "enum": ["New", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled"],
          "description": "Order fulfillment status"
        },
        "paymentReference": {
          "type": "string",
          "maxLength": 100,
          "description": "12-digit UPI UTR reference (required for Online orders)"
        },
        "paymentProofImage": {
          "type": "string",
          "maxLength": 260000,
          "description": "Compressed UPI payment receipt screenshot data URL (required for Online orders, Admin-only)"
        },
        "appsScriptSyncStatus": {
          "type": "string",
          "enum": ["Synced", "Pending", "Not Configured", "Failed"],
          "description": "Google Sheets sync state"
        },
        "appsScriptSyncMessage": {
          "type": "string",
          "maxLength": 500,
          "description": "Google Sheets sync message"
        },
        "resellerFieldsEnriched": {
          "type": "boolean",
          "description": "Whether admin reseller cost/profit fields have been attached"
        },
        "trackingHash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "SHA-256 hash of orderId and mobile for sanitized tracking lookup"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "orderId",
        "timestamp",
        "customerName",
        "mobileNumber",
        "email",
        "fullAddress",
        "city",
        "state",
        "pincode",
        "landmark",
        "items",
        "productNames",
        "productCodes",
        "quantity",
        "subtotal",
        "shippingFee",
        "totalAmount",
        "sourceOrderAmount",
        "expectedProfit",
        "paymentMethod",
        "paymentStatus",
        "codAmount",
        "orderStatus",
        "appsScriptSyncStatus",
        "resellerFieldsEnriched",
        "trackingHash",
        "createdAt",
        "updatedAt"
      ]
    },
