      "required": [
        "orderId",
        "timestamp",
        "customerName",
        "city",
        "state",
        "pincode",
        "items",
        "productNames",
        "productCodes",
        "quantity",
        "totalAmount",
        "paymentMethod",
        "paymentStatus",
        "codAmount",
        "orderStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Customer support inquiry submitted via storefront.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Support message ID"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Sender name"
        },
        "mobileOrEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "description": "Sender phone or email"
        },
        "orderId": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional Order ID reference"
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000,
          "description": "Support message body"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["id", "name", "mobileOrEmail", "message", "createdAt"]
    },
    "ReturnRequest": {
      "title": "ReturnRequest",
      "description": "Customer return or replacement request for a delivered order, keyed by SHA-256(orderId:mobile10) so customers can track pickup/refund status without exposing PII.",
      "type": "object",
      "properties": {
        "trackingHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 hash of orderId:mobile10"
        },
        "orderId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated Order ID"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Customer display name"
        },
        "requestType": {
          "type": "string",
          "enum": ["Return & Refund", "Replacement"],
          "description": "Whether customer wants refund or replacement"
        },
        "reason": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Selected return or exchange reason"
        },
        "details": {
          "type": "string",
          "maxLength": 1500,
          "description": "Customer issue description"
        },
        "customerUpiId": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional customer UPI ID for refund payout"
        },
        "proofImages": {
          "type": "array",
          "description": "Up to 3 compressed customer proof photos for Meesho return submission"
        },
        "returnStatus": {
          "type": "string",
          "enum": ["Requested", "Approved", "Pickup Scheduled", "Picked Up", "Completed", "Rejected"],
          "description": "Current return or replacement workflow stage"
        },
        "refundStatus": {
          "type": "string",
          "enum": ["Not Applicable", "Pending", "Meesho Refund Received", "Refunded to Customer"],
          "description": "Reseller-to-customer refund tracking status"
        },
        "meeshoReturnId": {
          "type": "string",
          "maxLength": 120,
          "description": "Meesho return/AWB reference ID"
        },
        "pickupNote": {
          "type": "string",
          "maxLength": 300,
          "description": "Reverse pickup schedule or courier note"
        },
        "adminNote": {
          "type": "string",
          "maxLength": 500,
          "description": "Admin status update note visible to customer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "trackingHash",
        "orderId",
        "customerName",
        "requestType",
        "reason",
        "details",
        "proofImages",
        "returnStatus",
        "refundStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin role markers.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Admin email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "createdAt"]
    },
    "UsedUtr": {
      "title": "UsedUtr",
      "description": "Zero-PII anti-replay lock keyed by SHA-256 of 12-digit UPI UTR to prevent duplicate UTR reuse.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Order ID that claimed this UTR"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["orderId", "createdAt"]
    },
    "CancelRequest": {
      "title": "CancelRequest",
      "description": "Customer pre-dispatch order cancellation request for New or Confirmed orders, keyed by SHA-256(orderId:mobile10).",
