        },
        "orderId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated Order ID"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
