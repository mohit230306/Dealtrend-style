# Firebase Web & Firestore Configuration (set these in your hosting dashboard, e.g. Render / Railway / Cloud Run)
# Leave firebase-applet-config.json out of GitHub; the app reads these environment variables automatically.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Optional: Server-side Google Apps Script Web App URL for order sync to Google Sheets
APPS_SCRIPT_URL=

