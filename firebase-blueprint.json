        "customerUpiId": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional customer UPI ID for refund if Online order"
        },
        "cancelStatus": {
          "type": "string",
          "enum": ["Requested", "Approved", "Rejected"],
          "description": "Current cancellation review state"
        },
        "adminNote": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional admin response note visible to customer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "trackingHash",
        "orderId",
        "customerName",
        "reason",
        "note",
        "cancelStatus",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/public_store/{docId}": {
      "schema": { "$ref": "#/entities/PublicStoreConfig" },
      "description": "Public customer storefront configuration at /public_store/config"
    },
    "/admin_settings/{docId}": {
      "schema": { "$ref": "#/entities/AdminSettingsConfig" },
      "description": "Private admin Google Apps Script and Drive settings at /admin_settings/config"
    },
    "/public_products/{productId}": {
      "schema": { "$ref": "#/entities/PublicProduct" },
      "description": "Publicly visible non-Hidden products without source price or supplier URL"
    },
    "/admin_products/{productId}": {
      "schema": { "$ref": "#/entities/AdminProduct" },
      "description": "Private reseller product catalog with source prices, expected profit, and supplier URLs"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Full customer orders with PII and reseller fulfillment details (Admin-only read/update/delete)"
    },
    "/order_tracking/{trackingHash}": {
      "schema": { "$ref": "#/entities/OrderTracking" },
      "description": "Zero-PII order status snapshot keyed by SHA-256(orderId:mobile10)"
    },
    "/return_requests/{trackingHash}": {
      "schema": { "$ref": "#/entities/ReturnRequest" },
      "description": "Customer return and replacement requests linked to delivered orders, keyed by SHA-256(orderId:mobile10)"
    },
    "/support_messages/{messageId}": {
      "schema": { "$ref": "#/entities/SupportMessage" },
      "description": "Customer support inquiries (Admin-only read/manage)"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Additional admin user role lookup documents"
    },
    "/used_utrs/{utrHash}": {
      "schema": { "$ref": "#/entities/UsedUtr" },
      "description": "Anti-replay UPI UTR lock documents keyed by SHA-256(12-digit UTR)"
    },
    "/cancel_requests/{trackingHash}": {
      "schema": { "$ref": "#/entities/CancelRequest" },
      "description": "Customer pre-dispatch order cancellation requests keyed by SHA-256(orderId:mobile10)"
    }
  }
}
